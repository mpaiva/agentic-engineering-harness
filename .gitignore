# Secrets and local tool state — never commit
.env
.env.*
*.key
*.pem
.atomic/
.herdr/
# Tool configs live in the user's home, not the repo; if copied in for reference, ignore
**/config.local.toml

# Live Atomic workflow run output (regenerated per run; not part of the repo)
.atomic/workflows/runs/
**/.runs/
# NOTE: docs/case-study-road-not-taken.md (committed) documents a real ./build.sh run in
# prose and screenshots — that is how this repo shows what good autonomous output looks like;
# build/ itself (see below) is always run output and is never committed.

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Node (in case a workflow package is added locally)
node_modules/

/build/
/build-*/

# subagent-driven-development scratch (ledger, briefs, review packages)
.superpowers/

# playwright-cli scratch, written by verifier agents during a run
.playwright-cli/

# Raw screenshots from scripts/capture-demo.sh. Hundreds of full-resolution PNGs per run —
# the GIF and any doc screenshots cut from them are committed, the negatives are not.
.captures/
