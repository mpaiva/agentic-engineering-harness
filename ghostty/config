# Ghostty config for the agentic engineering harness
# Install:  cp ghostty/config ~/.config/ghostty/config   (then super+shift+, to reload)
# Verified against Ghostty 1.3.1. All keys validated with:
#   /Applications/Ghostty.app/Contents/MacOS/ghostty +show-config --default
#
# Ghostty is only the interaction SURFACE. It does not orchestrate and knows nothing
# about agents — Herdr runs inside it. Keep this config about legibility and comfort for
# long supervision sessions, not about agent logic.

# ── Legibility: you read agent output for hours ────────────────────────────────
font-family = "JetBrains Mono"
font-size = 14
theme = "dark:catppuccin-mocha,light:catppuccin-latte"
cursor-style = block
mouse-hide-while-typing = true
copy-on-select = clipboard

# ── Keep long agent runs scrollable ────────────────────────────────────────────
# Autonomous agents can emit a lot. A generous scrollback means you can inspect
# evidence after the fact instead of losing it.
scrollback-limit = 100000000

# ── Comfortable padding so dense sidebars/logs don't hug the bezel ─────────────
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true

# ── Persist layout across restarts (Herdr also restores its own sessions) ──────
window-save-state = always

# ── Don't nag when closing a pane that's "just" running an agent process ───────
# You supervise by exception; a confirm dialog on every close is friction. Herdr
# holds the real sessions open regardless, so an accidental surface close is cheap.
confirm-close-surface = false
quit-after-last-window-closed = false

# ── Make an unfocused split clearly recede so the ACTIVE agent stands out ───────
unfocused-split-opacity = 0.6

# ── macOS: native, minimal titlebar so the terminal is the focus ───────────────
macos-titlebar-style = tabs
macos-option-as-alt = true

# ── Shell integration on (default) powers cursor/title/working-dir reporting, ──
# which also helps Herdr's screen-manifest state detection stay accurate.
shell-integration-features = cursor,sudo,title
