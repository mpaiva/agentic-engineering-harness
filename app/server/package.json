{
  "name": "@hcm/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HCM Core-HR slice — tRPC API over the Neo4j graph. Schema migration, write-path guards, deterministic seed, and the four marquee traversals all live behind the repository seam.",
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./router": {
      "types": "./src/router.ts",
      "default": "./src/router.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/seed/seed.ts",
    "validate": "tsx src/db/validate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@hono/trpc-server": "^0.4.2",
    "@trpc/server": "^11.18.0",
    "hono": "^4.13.1",
    "neo4j-driver": "^5.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/neo4j": "^12.1.0",
    "@types/node": "^22.20.1",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
