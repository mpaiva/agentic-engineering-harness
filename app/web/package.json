{
  "name": "@hcm/web",
  "private": true,
  "type": "module",
  "description": "HCM Graph Core-HR slice — web UI (React Router 7 + Vite). Directory, person view, and an accessible ARIA Tree org chart whose hierarchy IS the REPORTS_TO traversal. Loaders call the tRPC API server-side.",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hcm/server": "*",
    "@react-router/node": "^7.1.0",
    "@react-router/serve": "^7.1.0",
    "@trpc/client": "^11.0.0",
    "isbot": "^5.1.0",
    "react": "^19.0.0",
    "react-aria-components": "^1.5.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^4.1.10"
  }
}
